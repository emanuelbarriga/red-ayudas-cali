rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solo imágenes, máx 5 MB, en la carpeta de fotos de puntos.
    // Sin sobrescritura ni borrado (los nombres de archivo son únicos).
    match /fotos_puntos/{allPaths=**} {
      allow read: if true;
      allow create: if request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if false;
    }
  }
}
